#!/bin/sh
# Blocks pushes to main, then runs mvn verify if a root pom.xml exists.

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked; open a PR from a branch" >&2
    exit 1
  fi
done

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if [ ! -f pom.xml ]; then
  echo "pre-push: no root pom.xml yet, skipping mvn verify" >&2
  exit 0
fi
if ! command -v mvn >/dev/null 2>&1; then
  echo "pre-push: mvn not found, skipping mvn verify" >&2
  exit 0
fi

mvn -q verify || { echo "pre-push: mvn verify failed" >&2; exit 1; }
exit 0
